# Copy to .env (gitignored) at the repo root and fill in. Loaded by scripts via python-dotenv.

# Agent models through OpenRouter (src/minpilot/llm/specs.py). Also set a spending limit on the key itself.
OPENROUTER_API_KEY=""

# Web search (Serper: Google results as JSON); DuckDuckGo is the free fallback
SERPER_API_KEY=""

# Optional: reuse a running Crawl4AI page reader (e.g. the previous pilot's) instead of starting one
# CRAWL4AI_ENDPOINT=/home/dohyun/mas-uncertainty/pilot/outputs/servers/crawl4ai.json
